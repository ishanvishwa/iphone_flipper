# Core runtime
TZ=UTC
APP_ENV=production
API_PORT=8080
APP_API_TOKEN=replace_with_long_random_token
LISTING_EVENT_CHANNEL=listing_events

# Telegram alerts (optional, used by worker for new listing cards)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_MIN_PROFIT=0
# Cooldown for profile-failure alerts (seconds)
WORKER_PROFILE_FAILURE_ALERT_COOLDOWN_SECONDS=900
# Deduplicate manual-login Telegram alerts per route+reason window (seconds)
WORKER_MANUAL_LOGIN_ALERT_DEDUP_SECONDS=300

# PostgreSQL
POSTGRES_DB=iphone_flipper
POSTGRES_USER=flipper_app
POSTGRES_PASSWORD=replace_with_strong_password

# Redis
REDIS_PASSWORD=replace_with_strong_password

# Worker runtime
SCRAPE_INTERVAL_SECONDS=8
SCRAPE_INTERVAL_JITTER_PCT=0.25
WORKER_WAIT_BACKOFF_SECONDS=3
WORKER_MAX_BACKOFF_MULTIPLIER=5.0
WORKER_HEADLESS=1
WORKER_USER_DATA_DIR=/app/runtime/browser_profile_1
WORKER_CYCLE_RETRY_ATTEMPTS=3
WORKER_CYCLE_RETRY_BACKOFF_SECONDS=3
WORKER_CYCLE_RETRY_BACKOFF_MAX_SECONDS=60
WORKER_DEGRADED_CONSECUTIVE_CYCLES=3
WORKER_THROTTLED_CONSECUTIVE_CYCLES=5
WORKER_ROUTE_COOLDOWN_BAD_CYCLES=7
WORKER_ROUTE_COOLDOWN_SECONDS=900
WORKER_SINGLE_ROUTE_REST_MULTIPLIER=3.0
WORKER_MIN_ENABLED_ROUTES_WARN=2
# Auto-rotation proxy reuse control.
# Prevents immediate reuse of recently used proxies (seconds).
WORKER_PROXY_REUSE_COOLDOWN_SECONDS=120
# Maximum time a proxy lease is held by a worker during a scrape cycle (seconds).
WORKER_PROXY_LEASE_SECONDS=600
# Proxy health scoring and temporary bans.
PROXY_HEALTH_FAILURE_BAN_AFTER=3
PROXY_HEALTH_BASE_BAN_SECONDS=300
PROXY_HEALTH_MAX_BAN_SECONDS=7200
# Query-shard lock lease to avoid cross-worker duplicate shard scraping.
WORKER_QUERY_SHARD_LEASE_SECONDS=600
# Pre-checkpoint soft-signal detection controls.
ENABLE_SIGNAL_DETECTION=1
SIGNAL_RESULT_RATIO_THRESHOLD=0.5
SIGNAL_LOAD_TIME_MULTIPLIER=2.0
SIGNAL_ROLLING_ALPHA=0.2
SIGNAL_MIN_SUCCESS_CYCLES=5
SIGNAL_PAUSE_SECONDS=900
SIGNAL_THROTTLE_MULTIPLIER=2.0
SIGNAL_THROTTLE_DURATION=600
# Per-cycle browser persona variation (viewport/locale/timezone/UA)
ENABLE_FINGERPRINT_VARIATION=1
# Validate proxy binding per cycle (browser-level IP check)
VERIFY_PROXY_IP=1
PROXY_IP_CHECK_URL=https://api.ipify.org?format=json
PROXY_IP_CHECK_TIMEOUT_MS=20000
# Optional query shard for this worker (comma-separated)
# SCRAPER_QUERIES=iPhone 14 Pro,iPhone 14 Pro Max,iPhone 15 Pro,iPhone 15 Pro Max

# Fallback proxy for this worker (used only when no DB worker_routes exist for WORKER_NAME)
# Examples: socks5://proxy-host:1080 or http://proxy-host:8080
SCRAPER_PROXY_SERVER=
SCRAPER_PROXY_USERNAME=
SCRAPER_PROXY_PASSWORD=
SCRAPER_PROXY_MODE=fixed
SCRAPER_PROXY_POOL=

# Optional worker_2 (second profile/shard)
SCRAPE_INTERVAL_SECONDS_WORKER_2=8
SCRAPER_PROXY_SERVER_2=
SCRAPER_PROXY_USERNAME_2=
SCRAPER_PROXY_PASSWORD_2=
SCRAPER_PROXY_MODE_2=fixed
SCRAPER_PROXY_POOL_2=
# Optional query shard for worker_2
# SCRAPER_QUERIES_2=iPhone 14 Plus,iPhone 14 Pro,iPhone 14 Pro Max,iPhone 15,iPhone 15 Plus
SCRAPER_QUERIES_2=

# worker_3 fast lane (newest-listing sweep)
SCRAPER_PROXY_SERVER_3=
SCRAPER_PROXY_USERNAME_3=
SCRAPER_PROXY_PASSWORD_3=
SCRAPER_PROXY_MODE_3=fixed
SCRAPER_PROXY_POOL_3=
SCRAPER_QUERIES_3=iPhone
SCRAPE_INTERVAL_SECONDS_WORKER_3=5
WORKER_SCROLL_TARGET_CARDS_WORKER_3=100
WORKER_SCROLL_MAX_ROUNDS_WORKER_3=4

# Caddy reverse proxy
SERVER_DOMAIN=api.example.com
